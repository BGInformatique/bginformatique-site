# Fichiers sources non publiés (logos originaux, archives)
_source/

# Package de design livré (ne pas publier sur le site)
*.zip

# Banc d'essai TimeCalculator : fichiers régénérés à chaque exécution,
# jamais publiés (banc.html détourne Firebase vers des bouchons).
outils/tc-9x2k7m/tests/genere/

# Amorces de mandats : données internes de clients, jamais publiées.
# Elles vivent hors dépôt et s'importent par le sélecteur de fichier de l'outil.
outils/*/amorce-*.json

# Banc d'essai de BGFoods : Playwright et ses dépendances s'installent
# localement (npm i -D playwright) et n'ont rien à faire sur le site. Sans
# cette exclusion, deploy.sh — qui fait « git add . » — publierait 19 Mo de
# node_modules et ferait passer le site pour un projet Node.
node_modules/
package.json
package-lock.json
